{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:/KDT_AI_HACKATHON/.ai-sync/bridge.mjs claude",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:/KDT_AI_HACKATHON/.ai-sync/bridge.mjs claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:/KDT_AI_HACKATHON/.ai-sync/bridge.mjs claude",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ecc@ecc": true,
    "insane-search@gptaku-plugins": true,
    "gptaku-core@gptaku-plugins": true
  },
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/ECC.git"
      }
    },
    "gptaku-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/fivetaku/gptaku_plugins.git"
      }
    }
  },
  "env": {
    "GPTAKU_ROUTER": "off"
  }
}